# Copy to .env. Keep .env private; it is excluded from Git.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=vehicle_safety
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DB=vehicle_safety

# The read-only web account is generated by scripts/setup_readonly_user.py.
# Keep POSTGRES_USER/PASSWORD above for database construction/imports.
APP_POSTGRES_USER=vehicle_safety_reader
APP_POSTGRES_PASSWORD=

# Generated locally by scripts/setup_auth.py; do not share real values.
AUTH_POSTGRES_USER=vehicle_safety_auth
AUTH_POSTGRES_PASSWORD=
FLASK_SECRET_KEY=
# False for the current localhost HTTP server; true when serving through HTTPS.
SESSION_COOKIE_SECURE=false

# Generated by scripts/setup_workflow.py; writes only application workflow data.
WORKFLOW_POSTGRES_USER=vehicle_safety_workflow
WORKFLOW_POSTGRES_PASSWORD=

# Generated by scripts/setup_cases.py; structured cases and durable recovery tasks.
CASE_POSTGRES_USER=vehicle_safety_cases
CASE_POSTGRES_PASSWORD=

